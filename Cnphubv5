local matchTimeRemaining = 180
local isTimerRunning = false
local lastDetectedTime = 180

-- Tự động quét trạng thái sảnh / vào trận của MM2, MMV
task.spawn(function()
    while true do
        if isTimerRunning then
            local roundStarted = false
            pcall(function()
                -- Quét các giá trị thời gian và trạng thái round trong ReplicatedStorage của các game MM2/MMV
                for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
                    if obj:IsA("NumberValue") or obj:IsA("IntValue") then
                        local name = string.lower(obj.Name)
                        if string.find(name, "time") or string.find(name, "duration") or string.find(name, "clock") then
                            if obj.Value > 0 and obj.Value <= 900 then
                                matchTimeRemaining = obj.Value
                                roundStarted = true
                                break
                            end
                        end
                    end
                end
            end)

            -- Nếu đang ở sảnh (thời gian đứng yên hoặc không có biến trận đấu), giữ nguyên mốc 03:00 (hoặc thời gian chuẩn)
            -- Chỉ khi vào trận thực sự thì đồng hồ mới đếm ngược
            if not roundStarted then
                -- Logic dự phòng: Nếu game đếm lùi thì tự giảm, nếu đứng im ở sảnh thì reset về 180s
                if matchTimeRemaining > 0 then
                    matchTimeRemaining = matchTimeRemaining - 1
                end
            end

            if matchTimeRemaining < 0 then matchTimeRemaining = 0 end

            local mins = math.floor(matchTimeRemaining / 60)
            local secs = matchTimeRemaining % 60
            TimerLabel.Text = string.format("%02d:%02d", mins, secs)
        else
            matchTimeRemaining = 180 -- Đứng ở sảnh mặc định là 3 phút chờ
            TimerLabel.Text = "03:00"
        end
        task.wait(1)
    end
end)

