local PROXIMITY_DISTANCE = 35 -- Khoảng cách gần mới hiện tâm

local function UpdatePlayerMarkers()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            local tool = char:FindFirstChildOfClass("Tool")

            local markerGui = head and head:FindFirstChild("RoleMarkerGui")

            local inRange = false
            if myRoot and root then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist <= PROXIMITY_DISTANCE then
                    inRange = true
                end
            end

            if head and tool and inRange then
                local toolName = string.lower(tool.Name)
                local isMurderer = string.find(toolName, "knife") or string.find(toolName, "blade") or string.find(toolName, "dagger")
                local isSheriff = string.find(toolName, "gun") or string.find(toolName, "revolver") or string.find(toolName, "pistol")

                if isMurderer or isSheriff then
                    if not markerGui then
                        markerGui = Instance.new("BillboardGui")
                        markerGui.Name = "RoleMarkerGui"
                        markerGui.Size = UDim2.new(0, 40, 0, 40)
                        markerGui.StudsOffset = Vector3.new(0, 2.5, 0)
                        markerGui.AlwaysOnTop = true
                        markerGui.Parent = head

                        local dot = Instance.new("Frame")
                        dot.Name = "Dot"
                        dot.Size = UDim2.new(1, 0, 1, 0)
                        dot.BackgroundTransparency = 1
                        dot.Parent = markerGui

                        local corner = Instance.new("UICorner")
                        corner.CornerRadius = UDim.new(1, 0)
                        corner.Parent = dot

                        local stroke = Instance.new("UIStroke")
                        stroke.Name = "Stroke"
                        stroke.Thickness = 3
                        stroke.Parent = dot
                    end

                    local dot = markerGui:FindFirstChild("Dot")
                    if dot then
                        local stroke = dot:FindFirstChild("Stroke")
                        if isMurderer then
                            stroke.Color = Color3.fromRGB(255, 0, 0) -- Tâm đỏ cho Kẻ giết người
                        elseif isSheriff then
                            stroke.Color = Color3.fromRGB(0, 255, 0) -- Tâm xanh lá cho Cảnh sát trưởng
                        end
                    end
                    markerGui.Enabled = true
                else
                    if markerGui then markerGui.Enabled = false end
                end
            else
                if markerGui then markerGui.Enabled = false end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    pcall(UpdatePlayerMarkers)
end)

