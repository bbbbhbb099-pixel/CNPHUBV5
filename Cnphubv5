AimlockListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
AimlockListLayout.Parent = AimlockMenuHolder

local function RefreshAimlockList()
    targetButtonsMapping = {}
    for _, child in ipairs(AimlockMenuHolder:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local PlrBtn = Instance.new("TextButton")
            PlrBtn.Size = UDim2.new(0.95, 0, 0, 35)
            PlrBtn.Text = (activeAimlockTarget == plr) and ("[LOCKED] " .. plr.Name) or ("Target: " .. plr.Name)
            PlrBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            PlrBtn.Font = Enum.Font.GothamBold
            PlrBtn.TextSize = 13
            PlrBtn.Parent = AimlockMenuHolder
            StyleFrame(PlrBtn, Color3.fromRGB(220, 50, 130), 0.3)

            targetButtonsMapping[plr] = PlrBtn

            PlrBtn.MouseButton1Click:Connect(function()
                StartAimlock(plr)
                for p, btn in pairs(targetButtonsMapping) do
                    if btn and btn.Parent then
                        btn.Text = (activeAimlockTarget == p) and ("[LOCKED] " .. p.Name) or ("Target: " .. p.Name)
                    end
                end
            end)
        end
    end
    AimlockMenuHolder.CanvasSize = UDim2.new(0, 0, 0, count * 42)
end

