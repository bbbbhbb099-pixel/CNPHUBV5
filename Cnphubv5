-- Quản lý Aimlock
local activeAimlockTarget = nil
local aimlockConnection = nil
local targetButtonsMapping = {}

local function StopAimlock()
    activeAimlockTarget = nil
    if aimlockConnection then
        aimlockConnection:Disconnect()
        aimlockConnection = nil
    end
    for plr, btn in pairs(targetButtonsMapping) do
        if btn and btn.Parent then btn.Text = "Target: " .. plr.Name end
    end
end

local function StartAimlock(targetPlayer)
    if activeAimlockTarget == targetPlayer then
        StopAimlock()
        return
    end
    StopAimlock()
    activeAimlockTarget = targetPlayer

    if targetButtonsMapping[targetPlayer] and targetButtonsMapping[targetPlayer].Parent then
        targetButtonsMapping[targetPlayer].Text = "[LOCKED] " .. targetPlayer.Name
    end

    aimlockConnection = RunService.RenderStepped:Connect(function()
        if activeAimlockTarget and activeAimlockTarget.Character then
            local humanoid = activeAimlockTarget.Character:FindFirstChildOfClass("Humanoid")
            local rootPart = activeAimlockTarget.Character:FindFirstChild("HumanoidRootPart")

            if not humanoid or humanoid.Health <= 0 or not rootPart then
                local nextTarget = nil
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local h = p.Character:FindFirstChildOfClass("Humanoid")
                        local rp = p.Character:FindFirstChild("HumanoidRootPart")
                        if h and h.Health > 0 and rp then nextTarget = p break end
                    end
                end
                if nextTarget then StartAimlock(nextTarget) else StopAimlock() end
                return
            end

            local cam = workspace.CurrentCamera
            cam.CFrame = CFrame.new(cam.CFrame.Position, rootPart.Position)
        else
            StopAimlock()
        end
    end)
end

